# =============================================================================
# Transcription Pipeline Configuration
# =============================================================================

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=tiny

# Maximum upload file size in bytes (default: 25MB)
MAX_FILE_SIZE_BYTES=26214400

# Rate limiting: requests per minute per IP
RATE_LIMIT_PER_MINUTE=10

# Max concurrent Whisper inference jobs (prevents OOM under load)
MAX_CONCURRENT_TRANSCRIPTIONS=2

# API key for authentication (leave empty to disable auth)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory (relative or absolute path)
LOG_DIR=logs

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database URL (SQLite for dev, PostgreSQL for production)
# SQLite:      sqlite+aiosqlite:///./data/transcripts.db
# PostgreSQL:  postgresql+asyncpg://user:pass@localhost:5432/transcripts
DATABASE_URL=sqlite+aiosqlite:///./data/transcripts.db

# CORS: comma-separated origins (use '*' for development only)
# Production example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# Post-processing toggles
ENABLE_FILLER_REMOVAL=true
ENABLE_PUNCTUATION_CORRECTION=true
ENABLE_SPEAKER_SEGMENTATION=true

# Speaker segmentation interval in seconds
SPEAKER_SEGMENT_INTERVAL=30
